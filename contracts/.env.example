# ---- Contracts (copy to contracts/.env, then `source .env`) ----
# Never commit the real .env. Store your deployer key with `cast wallet import deployer --interactive`
# instead of putting a private key in this file.

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<your-key>
ETHERSCAN_API_KEY=

# Owner of the factory (use a Safe multisig on mainnet)
FACTORY_OWNER=
# Optional, comma-separated. Only works when the deployer wallet is also FACTORY_OWNER.
INITIAL_ISSUERS=
