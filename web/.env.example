# ---- Web app (copy to web/.env.local) ----

# Reown (WalletConnect) project id — https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC URLs — https://alchemy.com (leave empty to use public RPCs)
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Factory addresses printed by `forge script script/Deploy.s.sol`
NEXT_PUBLIC_FACTORY_ADDRESS_MAINNET=
NEXT_PUBLIC_FACTORY_ADDRESS_SEPOLIA=
NEXT_PUBLIC_FACTORY_ADDRESS_LOCAL=

# Show the local Anvil chain (31337) in the wallet picker
NEXT_PUBLIC_ENABLE_LOCAL=false

# Pinata JWT for document uploads to IPFS — https://pinata.cloud (server-side only, never NEXT_PUBLIC_)
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
